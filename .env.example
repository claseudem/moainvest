SECRET_KEY=cambia-esto-en-produccion
FLASK_DEBUG=1

# Segundos de caché para no saturar Yahoo Finance
QUOTE_CACHE_TTL=15
CANDLE_CACHE_TTL=60

# Envío de emails vía Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Imágenes optimizadas vía Cloudinary (https://console.cloudinary.com/settings/api-keys)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Alpha Vantage como proveedor de precios del Graficador (opcional)
# Clave gratuita en https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_CACHE_TTL=300

# Dukascopy como proveedor de precios del Graficador (sin clave)
DUKASCOPY_CACHE_TTL=60
