SECRET_KEY=cambia-esto-en-produccion
FLASK_DEBUG=1

# Segundos de caché para no saturar Yahoo Finance
QUOTE_CACHE_TTL=15
CANDLE_CACHE_TTL=60

# Envío de emails vía Resend (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Alpha Vantage como proveedor de precios del Graficador (opcional)
# Clave gratuita en https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
ALPHAVANTAGE_CACHE_TTL=300

# Login con InsForge (https://insforge.dev)
# URL: campo oss_host de .insforge/project.json. Anon key: npx @insforge/cli secrets get ANON_KEY
INSFORGE_URL=
INSFORGE_ANON_KEY=
# 1 = /app/ exige iniciar sesión; 0 = abierto
AUTH_REQUIRED=1
SESSION_DAYS=7
# API key del proyecto (solo servidor, nunca al frontend): campo api_key de .insforge/project.json
INSFORGE_API_KEY=

# Pronosticador: token de MotherDuck (https://app.motherduck.com/settings/tokens)
MOTHER_DUCK_TOKEN=
MOTHERDUCK_DATABASE=riesgo_olap
# Si MotherDuck no tiene raw_spy_daily, se usan los cierres diarios de Yahoo Finance
PRONOSTICADOR_TICKER=SPY
PRONOSTICADOR_YAHOO_PERIOD=10y
# MLflow opcional: sin URI no se registran corridas; con MLFLOW_UI_URL aparece el enlace
MLFLOW_TRACKING_URI=
MLFLOW_UI_URL=
